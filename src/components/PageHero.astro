---
import { withBase } from '../config/site';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  /** Brødkrummer, fx [{ label: 'Ydelser', href: '/ydelser' }]. Den aktuelle side tilføjes automatisk. */
  crumbs?: { label: string; href: string }[];
}

const { eyebrow, title, text, crumbs } = Astro.props;
---

<section class="border-b border-line">
  <div class="container-page pt-12 pb-16 sm:pt-16 sm:pb-20" data-reveal>
    {
      crumbs && (
        <nav aria-label="Brødkrummer" class="mb-8">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
            <li>
              <a href={withBase('/')} class="transition-colors hover:text-brand-700">Forside</a>
            </li>
            {crumbs.map((crumb) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true">/</span>
                <a href={withBase(crumb.href)} class="transition-colors hover:text-brand-700">
                  {crumb.label}
                </a>
              </li>
            ))}
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              <span aria-current="page" class="text-ink">{title}</span>
            </li>
          </ol>
        </nav>
      )
    }
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class:list={['h1', eyebrow && 'mt-4']}>{title}</h1>
      {text && <p class="lead mt-6 max-w-2xl">{text}</p>}
      <slot />
    </div>
  </div>
</section>
