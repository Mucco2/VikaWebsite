---
/**
 * Fast bjælke nederst på mobil med "Ring" og "Book vikar".
 */
import Icon from './Icon.astro';
import { phoneHref, withBase } from '../config/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] backdrop-blur-md sm:hidden"
  data-callbar
>
  <div class="grid grid-cols-2 gap-3">
    <a href={phoneHref} class="btn btn-secondary btn-sm">
      <Icon name="phone" class="size-4 text-brand-600" />
      Ring til os
    </a>
    <a href={withBase('/book-vikar')} class="btn btn-primary btn-sm">Book vikar</a>
  </div>
</div>
