---
import Icon from './Icon.astro';
import { site, nav, services, phoneHref, emailHref } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-white">
  <div class="container-page grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <a href="/" class="text-lg font-bold tracking-tight">{site.name}</a>
      <p class="prose-text mt-4 max-w-xs text-[0.95rem]">
        Pædagogiske vikarer til daginstitutioner, skoler, specialskoler, bosteder og kommuner.
      </p>
    </div>

    <div class="lg:col-span-3">
      <h2 class="text-sm font-semibold text-ink">Kontakt</h2>
      <ul class="mt-4 space-y-3 text-[0.95rem]">
        <li>
          <a href={phoneHref} class="inline-flex items-center gap-3 text-muted transition-colors hover:text-brand-700">
            <Icon name="phone" class="size-4 text-brand-600" />{site.phone}
          </a>
        </li>
        <li>
          <a href={emailHref} class="inline-flex items-center gap-3 text-muted transition-colors hover:text-brand-700">
            <Icon name="mail" class="size-4 text-brand-600" />{site.email}
          </a>
        </li>
        <li class="flex items-start gap-3 text-muted">
          <Icon name="mapPin" class="mt-0.5 size-4 shrink-0 text-brand-600" />
          <address class="not-italic">{site.address}</address>
        </li>
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-sm font-semibold text-ink">Ydelser</h2>
      <ul class="mt-4 space-y-3 text-[0.95rem]">
        {
          services.map((s) => (
            <li>
              <a href={`/ydelser/${s.slug}`} class="text-muted transition-colors hover:text-brand-700">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-3">
      <h2 class="text-sm font-semibold text-ink">Genveje</h2>
      <ul class="mt-4 space-y-3 text-[0.95rem]">
        <li><a href="/book-vikar" class="text-muted transition-colors hover:text-brand-700">Book en vikar</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-muted transition-colors hover:text-brand-700">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name} · CVR {site.cvr}</p>
      <a href="/privatlivspolitik" class="transition-colors hover:text-brand-700">Privatlivspolitik</a>
    </div>
  </div>
</footer>
