---
import Icon from './Icon.astro';

interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['space-y-4', className]}>
  {
    items.map((item) => (
      <li class="flex items-start gap-3">
        <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white">
          <Icon name="check" class="size-3.5" strokeWidth={2.5} />
        </span>
        <span class="text-ink">{item}</span>
      </li>
    ))
  }
</ul>
