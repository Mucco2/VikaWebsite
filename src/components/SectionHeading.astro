---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, title, text, align = 'left', as: Tag = 'h2', id } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class:list={[Tag === 'h1' ? 'h1' : 'h2', eyebrow && 'mt-3']}>{title}</Tag>
  {text && <p class="lead mt-5">{text}</p>}
  <slot />
</div>
