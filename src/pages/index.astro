---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CustomerCard from '../components/CustomerCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BackgroundVideo from '../components/BackgroundVideo.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import Steps from '../components/Steps.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, services, customerTypes, faqs, media, phoneHref, withBase } from '../config/site';
import { getArticles } from '../lib/articles';
import type { IconName } from '../lib/icons';

const steps: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'message',
    title: 'Kontakt os',
    text: 'Ring eller send en forespørgsel. Fortæl, hvem I mangler, hvornår og hvor længe.',
  },
  {
    icon: 'search',
    title: 'Vi matcher',
    text: 'Vi finder en vikar med den rette faglighed og erfaring til netop jeres børn, elever eller borgere.',
  },
  {
    icon: 'doorIn',
    title: 'Vikaren møder ind',
    text: 'Vikaren møder ind til aftalt tid, klar til at tage del i hverdagen. Bagefter følger vi op.',
  },
];

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'shield',
    title: 'Screenede vikarer',
    text: 'Alle vikarer er personligt interviewet, referencetjekket og har gyldig børneattest.',
  },
  {
    icon: 'clock',
    title: 'Hurtig hjælp',
    text: 'Vi tager telefonen tidligt og handler hurtigt – også når behovet opstår samme morgen.',
  },
  {
    icon: 'repeat',
    title: 'Faste ansigter',
    text: 'Ved længere forløb får I så vidt muligt den samme vikar. Det giver ro og kontinuitet.',
  },
  {
    icon: 'users',
    title: 'Personlig kontakt',
    text: 'I taler med mennesker, der kender jeres institution og ved, hvad I har brug for.',
  },
];

const filmPoints = [
  'Vi lærer jeres hverdag at kende, før vi sender en vikar',
  'Vikaren får en god overlevering og møder forberedt ind',
  'Vi følger op og bruger jeres feedback til næste gang',
];

const articles = (await getArticles()).slice(0, 3);
---

<BaseLayout image={media.filmPoster}>
  <!-- Hero med video -->
  <section class="relative overflow-hidden">
    <div class="container-page grid items-center gap-12 pt-10 pb-16 sm:pt-16 sm:pb-24 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow">Vikarbureau for det pædagogiske område</p>
        <h1 class="h1 mt-4">Pædagogiske vikarer, I&nbsp;kan stole på</h1>
        <p class="lead mt-6 max-w-xl">
          Vi leverer pædagoger, specialpædagoger og pædagogmedhjælpere til daginstitutioner, skoler, specialskoler,
          bosteder og kommuner.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={withBase('/book-vikar')} class="btn btn-primary">
            Book en vikar
            <Icon name="arrowRight" class="size-4" />
          </a>
          <a href={withBase('/bliv-vikar')} class="btn btn-secondary">Bliv vikar</a>
        </div>
        <p class="mt-8 flex items-center gap-3 text-[0.95rem] text-muted">
          <span class="inline-flex size-9 items-center justify-center rounded-full bg-brand-50 text-brand-600">
            <Icon name="phone" class="size-4" />
          </span>
          <span>
            Akut behov? Ring på{' '}
            <a href={phoneHref} class="text-link">{site.phone}</a>
          </span>
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-ink">
          {
            ['Børneattest på alle vikarer', 'Hjælp samme dag', 'Faste vikarer'].map((item) => (
              <li class="flex items-center gap-2">
                <Icon name="check" class="size-4 text-brand-600" strokeWidth={2.5} />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative lg:col-span-6" data-reveal>
        <div class="absolute -top-8 -right-8 hidden size-48 rounded-full bg-brand-100/80 blur-3xl sm:block" aria-hidden="true">
        </div>
        <BackgroundVideo
          video={media.heroVideo}
          poster={media.heroPoster}
          class="aspect-[4/3] rounded-[2rem] shadow-lift lg:aspect-square"
        />
        <!-- Små statuskort ovenpå videoen (dekorative) -->
        <div class="pointer-events-none absolute -bottom-6 -left-8 hidden space-y-2.5 sm:block" aria-hidden="true">
          <div class="flex items-center gap-3 rounded-2xl bg-white/95 p-3 pr-5 shadow-lift ring-1 ring-line backdrop-blur">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="search" class="size-[1.1rem]" />
            </span>
            <div>
              <p class="text-sm font-semibold">Vikar matchet</p>
              <p class="text-xs text-muted">Erfaring med målgruppen</p>
            </div>
          </div>
          <div class="ml-6 flex items-center gap-3 rounded-2xl bg-white/95 p-3 pr-5 shadow-lift ring-1 ring-line backdrop-blur sm:ml-10">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-600 text-white">
              <Icon name="check" class="size-[1.1rem]" strokeWidth={2.5} />
            </span>
            <div>
              <p class="text-sm font-semibold">Vikaren møder ind</p>
              <p class="text-xs text-muted">Mandag kl. 7.00</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Kunder -->
    <div class="container-page pt-6 pb-6">
      <div class="flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:gap-8" data-reveal>
        <p class="shrink-0 text-sm font-medium text-muted">Vi leverer vikarer til</p>
        <ul class="flex flex-wrap gap-2">
          {
            customerTypes.map((c) => (
              <li>
                <a
                  href={withBase(`/kunder/${c.slug}`)}
                  class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-medium text-ink ring-1 ring-line transition-colors hover:text-brand-700 hover:ring-brand-300"
                >
                  <Icon name={c.icon} class="size-4 text-brand-600" />
                  {c.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Ydelser -->
  <section class="section" aria-labelledby="ydelser-titel">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading
          id="ydelser-titel"
          eyebrow="Ydelser"
          title="Det kan vi hjælpe med"
          text="Uanset om I mangler en ekstra hånd i morgen tidlig eller en fast vikar i flere måneder."
        />
        <a href={withBase('/ydelser')} class="text-link shrink-0 text-[0.95rem]" data-reveal>Se alle ydelser</a>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service) => (
            <li data-reveal>
              <ServiceCard service={service} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Sådan fungerer det -->
  <section class="section border-y border-line bg-white" aria-labelledby="saadan-titel">
    <div class="container-page">
      <SectionHeading id="saadan-titel" eyebrow="Sådan fungerer det" title="Fra opkald til vikar i tre enkle trin" align="center" />
      <Steps steps={steps} class="mt-16" />
      <p class="mt-14 text-center" data-reveal>
        <a href={withBase('/saadan-arbejder-vi')} class="text-link text-[0.95rem]">Se, hvordan vi arbejder</a>
      </p>
    </div>
  </section>

  <!-- Hvorfor os -->
  <section class="section" aria-labelledby="hvorfor-titel">
    <div class="container-page grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="relative lg:col-span-5" data-reveal>
        <Img
          name="bliv-vikar"
          alt="Smilende pædagog på hug ved en pige, der maler ved et staffeli udenfor"
          class="aspect-[4/5] w-full rounded-[2rem] object-cover shadow-lift"
          sizes="(min-width: 1024px) 440px, 100vw"
        />
        <div class="absolute right-4 -bottom-6 left-4 rounded-2xl bg-white p-5 shadow-lift ring-1 ring-line sm:right-auto sm:left-8 sm:max-w-xs">
          <p class="flex items-center gap-2 text-sm font-semibold text-brand-700">
            <Icon name="shield" class="size-4" />
            Tryghed først
          </p>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            Ingen vikar kommer ud hos jer uden samtale, referencer og børneattest.
          </p>
        </div>
      </div>
      <div class="pt-6 lg:col-span-7 lg:pt-0">
        <SectionHeading
          id="hvorfor-titel"
          eyebrow="Hvorfor os"
          title="Tryghed for jer – og for dem, I passer på"
          text="Et godt vikariat starter længe før første vagt. Vi kender vores vikarer, og vi tager os tid til at forstå jeres hverdag."
        />
        <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2">
          {
            reasons.map((reason) => (
              <li class="flex gap-4" data-reveal>
                <span class="icon-tile">
                  <Icon name={reason.icon} />
                </span>
                <div>
                  <h3 class="h3">{reason.title}</h3>
                  <p class="prose-text mt-2 text-[0.95rem]">{reason.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a href={withBase('/om-os')} class="text-link mt-10 inline-block text-[0.95rem]" data-reveal>Læs mere om os</a>
      </div>
    </div>
  </section>

  <!-- Film -->
  <section class="bg-brand-900 py-20 text-white sm:py-28" aria-labelledby="film-titel">
    <div class="container-page grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <p class="text-sm font-semibold tracking-wide text-brand-200">Film</p>
        <h2 id="film-titel" class="h2 mt-3">Se, hvordan vi hjælper</h2>
        <p class="mt-5 text-lg leading-relaxed text-pretty text-white/80">
          Når en kollega mangler, skal hverdagen fortsætte. På under et minut kan I se, hvordan vi arbejder.
        </p>
        <ul class="mt-8 space-y-4">
          {
            filmPoints.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-white/15 text-white">
                  <Icon name="check" class="size-3.5" strokeWidth={2.5} />
                </span>
                <span class="text-white/90">{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lg:col-span-7" data-reveal>
        <VideoPlayer video={media.film} poster={media.filmPoster} title={media.filmTitle} duration={media.filmDuration} />
      </div>
    </div>
  </section>

  <!-- Hvem vi hjælper -->
  <section class="section" aria-labelledby="kunder-titel">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading
          id="kunder-titel"
          eyebrow="Hvem vi hjælper"
          title="Vikarer til hele det pædagogiske område"
          text="Hver arbejdsplads er forskellig. Vi tilpasser os jeres målgruppe, jeres rytme og jeres måde at arbejde på."
        />
        <a href={withBase('/kunder')} class="text-link shrink-0 text-[0.95rem]" data-reveal>Se alle målgrupper</a>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          customerTypes.map((customer) => (
            <li data-reveal>
              <CustomerCard customer={customer} class="h-full" />
            </li>
          ))
        }
        <li data-reveal>
          <a
            href={withBase('/kontakt')}
            class="group flex h-full min-h-80 flex-col justify-end rounded-2xl bg-brand-50 p-7 ring-1 ring-brand-100 transition-colors hover:bg-brand-100/70"
          >
            <span class="icon-tile bg-white"><Icon name="message" /></span>
            <h3 class="mt-5 text-xl font-semibold tracking-[-0.01em]">Står I ikke på listen?</h3>
            <p class="prose-text mt-2 text-[0.95rem]">
              Vi hjælper også andre pædagogiske og sociale tilbud. Fortæl os om jeres behov.
            </p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700">
              Kontakt os
              <Icon name="arrowRight" class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    image="cta-band"
    eyebrow="Bliv vikar"
    title="Vil du gøre en forskel – når det passer dig?"
    text="Vi søger pædagoger, specialpædagoger og pædagogmedhjælpere, der vil arbejde fleksibelt i daginstitutioner, skoler og bosteder."
    primary={{ label: 'Send din ansøgning', href: '/bliv-vikar#ansoeg' }}
    secondary={{ label: 'Læs om at være vikar', href: '/bliv-vikar' }}
  />

  <!-- Viden -->
  {
    articles.length > 0 && (
      <section class="section" aria-labelledby="viden-titel">
        <div class="container-page">
          <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
            <SectionHeading
              id="viden-titel"
              eyebrow="Viden"
              title="Gode råd fra hverdagen"
              text="Artikler til institutioner og vikarer – om alt fra børneattester til en god første dag."
            />
            <a href={withBase('/viden')} class="text-link shrink-0 text-[0.95rem]" data-reveal>
              Se alle artikler
            </a>
          </div>
          <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => (
              <li data-reveal>
                <ArticleCard article={article} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="section border-t border-line bg-white" aria-labelledby="faq-titel">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading
          id="faq-titel"
          eyebrow="Spørgsmål og svar"
          title="Det bliver vi ofte spurgt om"
          text="Kan du ikke finde svaret? Så ring eller skriv – vi svarer gerne."
        >
          <a href={withBase('/faq')} class="btn btn-secondary mt-8">
            Se alle spørgsmål
            <Icon name="arrowRight" class="size-4" />
          </a>
        </SectionHeading>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <FaqList items={faqs.institutioner.slice(0, 5)} openFirst />
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
