---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, services, customers, phoneHref, withBase } from '../config/site';
import type { IconName } from '../lib/icons';

const steps: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'message',
    title: 'Kontakt os',
    text: 'Ring eller send en forespørgsel. Fortæl, hvem I mangler, hvornår og hvor længe.',
  },
  {
    icon: 'search',
    title: 'Vi matcher',
    text: 'Vi finder en vikar med den rette faglighed og erfaring til netop jeres børn, elever eller borgere.',
  },
  {
    icon: 'doorIn',
    title: 'Vikaren møder ind',
    text: 'Vikaren møder ind til aftalt tid, klar til at tage del i hverdagen. Bagefter følger vi op.',
  },
];

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'shield',
    title: 'Screenede vikarer',
    text: 'Alle vikarer er personligt interviewet, referencetjekket og har gyldig børneattest.',
  },
  {
    icon: 'clock',
    title: 'Hurtig hjælp',
    text: 'Vi tager telefonen tidligt og handler hurtigt – også når behovet opstår samme morgen.',
  },
  {
    icon: 'repeat',
    title: 'Faste ansigter',
    text: 'Ved længere forløb får I så vidt muligt den samme vikar. Det giver ro og kontinuitet.',
  },
  {
    icon: 'users',
    title: 'Personlig kontakt',
    text: 'I taler med mennesker, der kender jeres institution og ved, hvad I har brug for.',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="container-page grid items-center gap-14 pt-14 pb-20 sm:pt-20 sm:pb-28 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Vikarbureau for det pædagogiske område</p>
        <h1 class="h1 mt-4">Pædagogiske vikarer, I&nbsp;kan stole på</h1>
        <p class="lead mt-6 max-w-xl">
          Vi leverer pædagoger, specialpædagoger og pædagogmedhjælpere til daginstitutioner, skoler, specialskoler,
          bosteder og kommuner.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={withBase('/book-vikar')} class="btn btn-primary">
            Book en vikar
            <Icon name="arrowRight" class="size-4" />
          </a>
          <a href={withBase('/bliv-vikar')} class="btn btn-secondary">Bliv vikar</a>
        </div>
        <p class="mt-8 flex items-center gap-3 text-[0.95rem] text-muted">
          <span class="inline-flex size-9 items-center justify-center rounded-full bg-brand-50 text-brand-600">
            <Icon name="phone" class="size-4" />
          </span>
          <span>
            Akut behov? Ring på{" "}
            <a href={phoneHref} class="text-link">{site.phone}</a>
          </span>
        </p>
      </div>

      <!-- Illustration (dekorativ) -->
      <div class="lg:col-span-5" data-reveal aria-hidden="true">
        <div class="relative rounded-[2rem] bg-brand-50 p-6 sm:p-10">
          <div class="absolute -top-6 -right-6 size-32 rounded-full bg-brand-100/70 blur-2xl"></div>
          <div class="relative space-y-3">
            <div class="flex items-center gap-4 rounded-2xl bg-white p-4 shadow-soft ring-1 ring-line">
              <span class="icon-tile"><Icon name="calendar" /></span>
              <div class="min-w-0">
                <p class="text-sm font-semibold">Forespørgsel modtaget</p>
                <p class="truncate text-sm text-muted">Pædagog · 3 uger</p>
              </div>
            </div>
            <div class="flex items-center gap-4 rounded-2xl bg-white p-4 shadow-soft ring-1 ring-line sm:ml-8">
              <span class="icon-tile"><Icon name="search" /></span>
              <div class="min-w-0">
                <p class="text-sm font-semibold">Vikar matchet</p>
                <p class="truncate text-sm text-muted">Erfaring med målgruppen</p>
              </div>
            </div>
            <div class="flex items-center gap-4 rounded-2xl bg-white p-4 shadow-soft ring-1 ring-line sm:ml-16">
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-600 text-white">
                <Icon name="check" strokeWidth={2.25} />
              </span>
              <div class="min-w-0">
                <p class="text-sm font-semibold">Vikaren møder ind</p>
                <p class="truncate text-sm text-muted">Mandag kl. 7.00</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Kunder -->
    <div class="container-page pb-6">
      <div class="flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:gap-8" data-reveal>
        <p class="shrink-0 text-sm font-medium text-muted">Vi leverer vikarer til</p>
        <ul class="flex flex-wrap gap-2">
          {
            customers.map((c) => (
              <li class="rounded-full bg-white px-4 py-1.5 text-sm font-medium text-ink ring-1 ring-line">{c}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Ydelser -->
  <section class="section" aria-labelledby="ydelser-titel">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading id="ydelser-titel" eyebrow="Ydelser" title="Det kan vi hjælpe med" />
        <a href={withBase('/ydelser')} class="text-link shrink-0 text-[0.95rem]" data-reveal>Se alle ydelser</a>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service) => (
            <li data-reveal>
              <ServiceCard service={service} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Sådan fungerer det -->
  <section class="section border-y border-line bg-white" aria-labelledby="saadan-titel">
    <div class="container-page">
      <SectionHeading
        id="saadan-titel"
        eyebrow="Sådan fungerer det"
        title="Fra opkald til vikar i tre enkle trin"
        align="center"
      />
      <ol class="mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          steps.map((step, i) => (
            <li class="relative text-center" data-reveal>
              {i < steps.length - 1 && (
                <span class="absolute top-7 left-[calc(50%+3rem)] hidden h-px w-[calc(100%-6rem)] bg-line md:block" />
              )}
              <span class="relative mx-auto inline-flex size-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                <Icon name={step.icon} class="size-6" />
              </span>
              <p class="mt-6 text-sm font-semibold text-brand-600">Trin {i + 1}</p>
              <h3 class="h3 mt-1">{step.title}</h3>
              <p class="prose-text mx-auto mt-3 max-w-xs text-[0.95rem]">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Hvorfor os -->
  <section class="section" aria-labelledby="hvorfor-titel">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          id="hvorfor-titel"
          eyebrow="Hvorfor os"
          title="Tryghed for jer – og for dem, I passer på"
          text="Et godt vikariat starter længe før første vagt. Vi kender vores vikarer, og vi tager os tid til at forstå jeres hverdag."
        >
          <a href={withBase('/om-os')} class="text-link mt-6 inline-block text-[0.95rem]">Læs mere om os</a>
        </SectionHeading>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
        {
          reasons.map((reason) => (
            <li class="card p-7" data-reveal>
              <span class="icon-tile">
                <Icon name={reason.icon} />
              </span>
              <h3 class="h3 mt-6">{reason.title}</h3>
              <p class="prose-text mt-3 text-[0.95rem]">{reason.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
