---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Siden findes ikke" noindex>
  <section class="container-page flex min-h-[60vh] items-center py-20">
    <div class="mx-auto max-w-xl text-center">
      <p class="eyebrow">Fejl 404</p>
      <h1 class="h2 mt-4">Vi kan ikke finde siden</h1>
      <p class="lead mt-5">Siden er måske flyttet eller findes ikke længere.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Gå til forsiden</a>
        <a href="/kontakt" class="btn btn-secondary">Kontakt os</a>
      </div>
    </div>
  </section>
</BaseLayout>
